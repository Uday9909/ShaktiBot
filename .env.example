# EMBED_MODEL=nomic-embed-text
# WHISPER_MODEL=small
# TOP_K=4
# CHUNK_WORDS=200
# PIPER_VOICE=voices/en_US-lessac-medium.onnx
# BROWSER_API_BASE_URL=http://localhost:8000   # URL the browser uses to reach the API
