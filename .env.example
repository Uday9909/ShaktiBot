# Copy this file to .env to override any default. All values are optional.
# OLLAMA_HOST=http://ollama:11434        # http://localhost:11434 when run without Docker
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# EMBED_MODEL=nomic-embed-text
# WHISPER_MODEL=small
# LLM_NUM_PREDICT=120        # short overview answers return faster
# TOP_K=3
# CHUNK_WORDS=200
# RAG_DISTANCE_THRESHOLD=0.45
# TTS_PROVIDER=auto          # English Piper; Hindi/Marathi neural voices when online
# TIMEZONE=Asia/Kolkata
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60
# ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# PIPER_VOICE=voices/en_US-lessac-medium.onnx
# BROWSER_API_BASE_URL=http://localhost:8000   # URL the browser uses to reach the API
# RELAY_HOST=0.0.0.0                           # result relay bind (0.0.0.0 inside Docker)
# RELAY_PORT=8502                              # 0 = random port for local dev
